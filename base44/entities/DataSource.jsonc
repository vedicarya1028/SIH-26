{
  "name": "DataSource",
  "type": "object",
  "properties": {
    "source_name": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "access_method": {
      "type": "string",
      "enum": [
        "Public API",
        "CSV Download",
        "Manual Import",
        "Synthetic Demo"
      ]
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "Live",
        "Cached",
        "Unavailable",
        "Demo"
      ]
    },
    "last_sync": {
      "type": "string",
      "format": "date-time"
    },
    "record_count": {
      "type": "number"
    }
  },
  "required": [
    "source_name",
    "sync_status"
  ]
}