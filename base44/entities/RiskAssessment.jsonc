{
  "name": "RiskAssessment",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "project_code": {
      "type": "string"
    },
    "risk_score": {
      "type": "number"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Critical"
      ]
    },
    "cost_risk": {
      "type": "number"
    },
    "delay_risk": {
      "type": "number"
    },
    "implementation_risk": {
      "type": "number"
    },
    "explanation": {
      "type": "string"
    },
    "recommended_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "model_version": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "project_id",
    "risk_score",
    "risk_level",
    "model_version"
  ]
}